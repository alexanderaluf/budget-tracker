{
  "expo": {
    "name": "Plutus",
    "slug": "plutus",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "backgroundColor": "#DCE7E0",
    "scheme": "plutus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.plutus.budgettracker",
      "backgroundColor": "#DCE7E0",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Plutus to select profile photos and receipt images.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DCE7E0",
          "image": "./assets/splash-logo.png",
          "imageWidth": 100
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
